# Gemini — viết kịch bản, free tier cho demo
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# TTS — ZeroTTS chính, Edge-TTS dự phòng
TTS_PROVIDER=zerotts
ZEROTTS_MODEL=zeroweight-ai/ZeroTTS
ZEROTTS_VOICE=maichi
EDGE_TTS_VOICE=vi-VN-NamMinhNeural

# Video
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
SLIDE_PRE_PAUSE=0.8
SLIDE_POST_PAUSE=1.5
